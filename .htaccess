<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Block direct access to sensitive root files & folders
    RewriteRule ^(\.env|composer\.(json|lock)|artisan|phpunit\.xml|vendor|storage|database|app|config|routes|resources|tests) - [F,L]

    # Redirect root access to public/ when served from a subfolder (e.g. MAMP htdocs/auth)
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ /auth/public/$1 [R=302,L]
</IfModule>
